<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Compose owns the in-app Material 3 styling. This platform theme only
         controls the window background while the activity starts. -->
    <style name="Theme.CounsellingSupport" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/warm_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
